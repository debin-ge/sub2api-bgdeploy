# 每个站点复制一份到 envs/<slug>.env，并 chmod 600。
# POSTGRES_PASSWORD、REDIS_PASSWORD、JWT_SECRET、TOTP_ENCRYPTION_KEY、
# ADMIN_EMAIL、ADMIN_PASSWORD 是部署前强制检查项，必须全部填写且不能保留示例值。

TZ=Asia/Shanghai
SERVER_MODE=release
RUN_MODE=standard

POSTGRES_USER=app
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=app
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAINTENANCE_WORK_MEM=64MB

# 蓝绿并存时总连接上限约为单实例值的 2 倍。
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=25
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

REDIS_PASSWORD=change_this_redis_password
REDIS_DB=0
REDIS_POOL_SIZE=256
REDIS_MIN_IDLE_CONNS=10

JWT_SECRET=change_this_fixed_jwt_secret
TOTP_ENCRYPTION_KEY=change_this_fixed_totp_key

ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=change_this_admin_password
SETUP_MIGRATION_TIMEOUT_SECONDS=300

# 两个 slot 共享 /app/data；建议用 Docker stdout，避免共同轮转同一日志文件。
LOG_OUTPUT_TO_STDOUT=true
LOG_OUTPUT_TO_FILE=false

GATEWAY_IMAGE_STREAM_DATA_INTERVAL_TIMEOUT=900
GATEWAY_IMAGE_STREAM_KEEPALIVE_INTERVAL=10
GATEWAY_IMAGE_CONCURRENCY_ENABLED=false
